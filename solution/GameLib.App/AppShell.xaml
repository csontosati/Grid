<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:GameLib.App.Views"
       xmlns:models="clr-namespace:GameLib.BL.Models;assembly=GameLib.BL"
       x:Class="GameLib.App.AppShell"
       FlyoutBehavior="Flyout"
       FlyoutBackgroundColor="#1A1A1A"
       FlyoutWidth="200"
       Shell.NavBarIsVisible="False" 
       Title="GameLib">

    <Shell.FlyoutHeader>
        <VerticalStackLayout Padding="30, 40, 30, 20" Spacing="10" BackgroundColor="#1A1A1A">
            <Label Text="GameLib" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   TextColor="#deff9a" />
            <BoxView HeightRequest="1" 
                     Color="#333333" 
                     HorizontalOptions="Fill" 
                     Margin="0,10,0,0"/>
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <!-- Login View - Hidden from Flyout -->
    <ShellItem FlyoutItemIsVisible="False">
        <ShellContent
            Title="Login"
            ContentTemplate="{DataTemplate views:UserSelectionView}"
            Route="UserSelectionView" />
    </ShellItem>

    <!-- Discover Menu Item with Command Support -->
    <ShellItem Title="Discover" x:Name="DiscoverItem">
        <ShellContent ContentTemplate="{DataTemplate views:DiscoverView}" 
                      Route="DiscoverView" />
    </ShellItem>

    <!-- Libraries Section in Flyout Footer -->
    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="20,10" BackgroundColor="#1A1A1A" Spacing="5">
            <BoxView HeightRequest="1" Color="#333333" HorizontalOptions="Fill" />
            <Label Text="Libraries" 
                   TextColor="#deff9a" 
                   FontSize="12" 
                   FontAttributes="Bold"
                   Padding="10,8" />
            <CollectionView ItemsSource="{Binding Libraries}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:LibraryListModel">
                        <Frame Margin="0" Padding="0" CornerRadius="0" BorderColor="Transparent" HasShadow="False">
                            <Grid Padding="0" BackgroundColor="Transparent">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type Shell}}, Path=BindingContext.SelectLibraryCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Label Text="{Binding Name}"
                                       TextColor="White" 
                                       FontSize="15"
                                       Padding="20,8,20,8" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

</Shell>