<?xml version="1.0" encoding="utf-8" ?>
<views:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       xmlns:d="http://schemas.microsoft.com/dotnet/2021/maui/design"
                       xmlns:views="clr-namespace:GameLib.App.Views"
                       xmlns:vm="clr-namespace:GameLib.App.ViewModels"
                       x:Class="GameLib.App.Views.LibraryView"
                       x:DataType="vm:AppShellViewModel">

    <Grid RowDefinitions="Auto, *" Padding="10">

        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">

            <Label Grid.Column="0" 
                   Text="Library" 
                   FontSize="32" 
                   FontAttributes="Bold" 
                   TextColor="White"
                   VerticalOptions="Center" />

            <ImageButton Grid.Column="1" 
                         Source="profile_placeholder.png" 
                         WidthRequest="40" 
                         HeightRequest="40" 
                         CornerRadius="20" 
                         VerticalOptions="Center"
                         Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AppShellViewModel}}, Path=GoToUserSettingsCommand}"
                         CommandParameter="{Binding .}" />
        </Grid>

        <CollectionView Grid.Row="1"
                        SelectionMode="Single"
                        SelectionChanged="OnGameSelected">

            <d:CollectionView.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Hra 1</x:String>
                    <x:String>Hra 2</x:String>
                    <x:String>Hra 3</x:String>
                    <x:String>Hra 4</x:String>
                    <x:String>Hra 5</x:String>
                    <x:String>Hra 6</x:String>
                </x:Array>
            </d:CollectionView.ItemsSource>

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="3" 
                                 HorizontalItemSpacing="10" VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame CornerRadius="12" Padding="0" IsClippedToBounds="True" BackgroundColor="#2D2D2D" BorderColor="Transparent">
                        <Grid RowDefinitions="180, Auto">

                            <BoxView Grid.Row="0" Color="#404040" />
                            <Label Grid.Row="0" d:Text="Picture" TextColor="#777" HorizontalOptions="Center" VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Row="1" Padding="15">
                                <Label d:Text="This is the name of the game" TextColor="White" FontAttributes="Bold" FontSize="16" />
                                <Label d:Text="Game Studio" TextColor="#A0A0A0" FontSize="12" Margin="0,5,0,0" />
                            </VerticalStackLayout>

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>
</views:ContentPageBase>