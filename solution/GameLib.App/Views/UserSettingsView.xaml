<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GameLib.App.Views.UserSettingsView"
             Title="Profile Settings"
             BackgroundColor="#121212">

    <VerticalStackLayout VerticalOptions="Center" Padding="40" Spacing="20" MaximumWidthRequest="400">

        <Label Text="Profile Settings" FontSize="32" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" Margin="0,0,0,20"/>

        <Entry Placeholder="Username" Text="Ati_GOAT" BackgroundColor="#2D2D2D" TextColor="White" />
        <Entry Placeholder="Email" Text="ati@goat.com" BackgroundColor="#2D2D2D" TextColor="White" />

        <Button Text="Save Changes" 
                BackgroundColor="#00A8E8" 
                TextColor="White" 
                CornerRadius="8" />

        <Button Text="Sign Out" 
                BackgroundColor="#BD1E1E" 
                TextColor="White" 
                CornerRadius="8" 
                Margin="0,40,0,0"
                Clicked="OnSignOutClicked" />
    </VerticalStackLayout>
</ContentPage>