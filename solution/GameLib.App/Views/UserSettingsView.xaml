<views:ContentPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:GameLib.App.Views"
             xmlns:vm="clr-namespace:GameLib.App.ViewModels"
             x:Class="GameLib.App.Views.UserSettingsView"
             x:DataType="vm:UserSettingsViewModel"
             Title=""
             BackgroundColor="#121212">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20">

        <Button Grid.Row="0"
                Text="Sign Out"
                BackgroundColor="#2D2D2D"
                TextColor="White"
                CornerRadius="8"
                HorizontalOptions="End"
                Padding="20,10"
                Command="{Binding SignOutCommand}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="0,20">

                <Label Text="Profile Settings"
                       FontSize="32" FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Entry Grid.Column="0" Placeholder="Email"
                           Text="{Binding User.Email}"
                           BackgroundColor="#2D2D2D" TextColor="White" PlaceholderColor="#A0A0A0" />
                    <Entry Grid.Column="1" Placeholder="Username"
                           Text="{Binding User.UserName}"
                           BackgroundColor="#2D2D2D" TextColor="White" PlaceholderColor="#A0A0A0" />
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Entry Grid.Column="0" Placeholder="First Name"
                           Text="{Binding User.FirstName}"
                           BackgroundColor="#2D2D2D" TextColor="White" PlaceholderColor="#A0A0A0" />
                    <Entry Grid.Column="1" Placeholder="Last Name"
                           Text="{Binding User.LastName}"
                           BackgroundColor="#2D2D2D" TextColor="White" PlaceholderColor="#A0A0A0" />
                </Grid>

                <Button Text="Save"
                        BackgroundColor="#deff9a"
                        TextColor="#121212"
                        CornerRadius="8"
                        HorizontalOptions="End"
                        Padding="20,10"
                        Command="{Binding SaveUserCommand}" />

            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2"
                Text="Delete Account"
                BackgroundColor="#BD1E1E"
                TextColor="White"
                CornerRadius="8"
                HorizontalOptions="End"
                Padding="20,10"
                Margin="0,10,0,0"
                Command="{Binding DeleteAccountCommand}" />

    </Grid>
</views:ContentPageBase>